<Project Sdk="Microsoft.NET.Sdk">

  <!-- Empi Launcher's interface for Linux (and anything Avalonia runs on): the same engine and the same pipe protocol as the WPF one, drawn with Avalonia.
       The WPF app (EmpiLauncher.App) stays the Windows interface; nothing here is built by native/build/build.mjs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EmpiLauncher</AssemblyName>
    <RootNamespace>EmpiLauncher.Linux</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="..\EmpiLauncher.Ipc\EmpiLauncher.Ipc.csproj" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\EmpiLauncher.App\Styles\styles.json" Link="Styles\styles.json" />
  </ItemGroup>

</Project>
