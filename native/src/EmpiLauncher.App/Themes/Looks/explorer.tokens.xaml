<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- EXPLORER: an old desktop, in the look of that era's blue theme: beige window bodies, black Tahoma, a glossy blue title bar (drawn by
         the background, ExplorerField), rounded push buttons, blue and red caption buttons, a green Play and the blue selection of the
         time. No real logo of any company is drawn. -->

    <Color x:Key="WellColor">#245edc</Color>
    <Color x:Key="BgColor">#ece9d8</Color>
    <Color x:Key="SurfaceColor">#ece9d8</Color>
    <Color x:Key="Surface2Color">#f5f4ea</Color>
    <Color x:Key="Surface3Color">#d6d0c5</Color>
    <Color x:Key="LineColor">#d0d0bf</Color>
    <Color x:Key="LineStrongColor">#7f9db9</Color>
    <Color x:Key="PaperColor">#111111</Color>
    <Color x:Key="Paper2Color">#333333</Color>
    <Color x:Key="Paper3Color">#5e5e5e</Color>
    <Color x:Key="PaperInkColor">#404040</Color>

    <SolidColorBrush x:Key="WellBrush" Color="#245edc"/>
    <SolidColorBrush x:Key="BgBrush" Color="#ece9d8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#ece9d8"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#f5f4ea"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#d6d0c5"/>
    <SolidColorBrush x:Key="LineBrush" Color="#d0d0bf"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#7f9db9"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#111111"/>
    <SolidColorBrush x:Key="Paper2Brush" Color="#333333"/>
    <SolidColorBrush x:Key="Paper3Brush" Color="#5e5e5e"/>
    <SolidColorBrush x:Key="PaperInkBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ModuleBrush" Color="#ece9d8"/>
    <SolidColorBrush x:Key="HairBrush" Color="#7f9db9"/>
    <SolidColorBrush x:Key="HairStrongBrush" Color="#003c74"/>
    <SolidColorBrush x:Key="TintBrush" Color="#10000000"/>
    <SolidColorBrush x:Key="TintHoverBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="DockBrush" Color="#ece9d8"/>
    <SolidColorBrush x:Key="DockEdgeBrush" Color="#7f9db9"/>
    <SolidColorBrush x:Key="ChromeInkBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="ChromeBoxBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TitleBrush" Color="#111111"/>
    <SolidColorBrush x:Key="InputBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="DialogBrush" Color="#ece9d8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#f5f4ea"/>
    <SolidColorBrush x:Key="TabsBrush" Color="#ece9d8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#c0321c"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#a86a00"/>
    <SolidColorBrush x:Key="OkBrush" Color="#2a8a2a"/>

    <Color x:Key="CardOnColor">#316ac5</Color>
    <Color x:Key="CardOnInkColor">#ffffff</Color>
    <Color x:Key="CardOnMetaColor">#dce6f8</Color>
    <Color x:Key="CardOffInkColor">#111111</Color>
    <Color x:Key="CardOffMetaColor">#5e5e5e</Color>

    <FontFamily x:Key="DisplayFont">Tahoma, Verdana, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Tahoma, Verdana, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Tahoma, Verdana, Segoe UI</FontFamily>

    <CornerRadius x:Key="RadiusInput">2</CornerRadius>
    <CornerRadius x:Key="RadiusTile">3</CornerRadius>
    <CornerRadius x:Key="RadiusModule">4</CornerRadius>
    <CornerRadius x:Key="RadiusDock">4</CornerRadius>
    <CornerRadius x:Key="RadiusPlay">6</CornerRadius>
    <CornerRadius x:Key="RadiusChromeBox">0</CornerRadius>
    <SolidColorBrush x:Key="ChromeBoxEdgeBrush" Color="#00000000"/>
</ResourceDictionary>
