<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- OLEAJE's own control shapes, merged after Themes/Controls.xaml: light display type, glass panels with a pale edge and big round
         corners, tags as round pebbles, and Jugar in pale paper (StyleTheme gives it deep blue ink). -->

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper2Brush}"/>
    </Style>
    <Style x:Key="Module" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ModuleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Padding" Value="24,20"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="#0Fffffff"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"/>
        <Setter Property="Padding" Value="11,3"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="#f1ede0"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayInkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
