<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PUNK: a photocopied zine. Newsprint pages ripped out by hand (the panels are torn paper, not boxes), toner-black ink, one spot
         colour (the accent), poster type (Impact) over typewriter text (Courier), and nothing rounded. The chosen card is a black sticker. -->

    <Color x:Key="WellColor">#d6d0c3</Color>
    <Color x:Key="BgColor">#e4dfd3</Color>
    <Color x:Key="SurfaceColor">#f1ece2</Color>
    <Color x:Key="Surface2Color">#e6e0d4</Color>
    <Color x:Key="Surface3Color">#d8d2c4</Color>
    <Color x:Key="LineColor">#bdb6a8</Color>
    <Color x:Key="LineStrongColor">#141214</Color>
    <Color x:Key="PaperColor">#141214</Color>
    <Color x:Key="Paper2Color">#2a2528</Color>
    <Color x:Key="Paper3Color">#4f494b</Color>
    <Color x:Key="PaperInkColor">#141214</Color>

    <SolidColorBrush x:Key="WellBrush" Color="#d6d0c3"/>
    <SolidColorBrush x:Key="BgBrush" Color="#e4dfd3"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#f1ece2"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#e6e0d4"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#d8d2c4"/>
    <SolidColorBrush x:Key="LineBrush" Color="#bdb6a8"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#141214"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#141214"/>
    <SolidColorBrush x:Key="Paper2Brush" Color="#2a2528"/>
    <SolidColorBrush x:Key="Paper3Brush" Color="#4f494b"/>
    <SolidColorBrush x:Key="PaperInkBrush" Color="#141214"/>

    <!-- a page torn out by hand: the jagged outline is drawn in a 100 x 100 box and stretched over the panel, whatever its size -->
    <DrawingBrush x:Key="ModuleBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 L100,0 100,100 0,100Z"/>
                <GeometryDrawing Brush="#f1ece2"
                                 Geometry="M0,1.4 L3,0.3 6,1.2 9.5,0 13,1 16,0.2 20,1.3 24,0.1 27.5,1.1 31,0.4 35,1.4 38,0.2 42,1 46,0 49,1.2 53,0.3 57,1.1 60,0 64,1.3 67.5,0.4 71,1.2 75,0.1 78,1 82,0.3 85.5,1.3 89,0.2 93,1.1 96,0.3 100,0.9
                                           L99.3,5 100,10 99.1,15 99.8,20 99.2,26 100,31 99.3,37 99.9,42 99.1,48 100,53 99.4,59 99.9,64 99.2,70 100,75 99.3,81 99.8,86 99.1,92 100,96 99.4,100
                                           L96,98.9 92,99.8 88.5,98.8 85,99.9 81,99 77,99.7 73.5,98.7 70,99.6 66,98.9 62,99.9 58.5,98.8 55,99.7 51,99 47,99.9 43.5,98.8 40,99.6 36,98.9 32,99.8 28.5,98.7 25,99.7 21,99 17,99.9 13.5,98.8 10,99.6 6,98.9 2.5,99.8 0,99.1
                                           L0.8,94 0,89 0.7,84 0.1,78 0.9,73 0,68 0.8,62 0.2,57 0.9,52 0,46 0.7,41 0.1,35 0.9,30 0,25 0.8,19 0.2,14 0.9,9 0,5Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="DockBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 L100,0 100,100 0,100Z"/>
                <GeometryDrawing Brush="#f1ece2"
                                 Geometry="M0,4 L4,0.5 8,3 12,0 17,2.5 21,0.8 26,3.2 30,0 35,2.2 39,0.4 44,3 48,0.2 53,2.6 57,0.3 62,3.1 66,0.6 71,2.4 75,0 80,3 84,0.7 89,2.8 93,0.2 97,2.5 100,0.8
                                           L99.2,15 100,30 99.3,46 100,62 99.1,78 100,92 99.4,100
                                           L95,97 91,99.6 86,97.2 82,99.9 77,97.5 73,99.5 68,97 64,100 59,97.4 55,99.4 50,97.1 46,99.8 41,97.6 37,99.3 32,97.2 28,99.9 23,97.4 19,99.6 14,97 10,99.7 5,97.5 0,99.4
                                           L0.9,85 0,70 0.8,55 0.1,40 0.9,25 0,12Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="DockEdgeBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="HairBrush" Color="#40141214"/>
    <SolidColorBrush x:Key="HairStrongBrush" Color="#141214"/>
    <SolidColorBrush x:Key="TintBrush" Color="#14141214"/>
    <SolidColorBrush x:Key="TintHoverBrush" Color="#26141214"/>
    <SolidColorBrush x:Key="ChromeInkBrush" Color="#141214"/>
    <SolidColorBrush x:Key="ChromeBoxBrush" Color="#f1ece2"/>
    <SolidColorBrush x:Key="ChromeBoxEdgeBrush" Color="#141214"/>
    <SolidColorBrush x:Key="TitleBrush" Color="#141214"/>
    <SolidColorBrush x:Key="InputBrush" Color="#fffdf8"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#33141214"/>
    <SolidColorBrush x:Key="DialogBrush" Color="#f1ece2"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#f1ece2"/>
    <SolidColorBrush x:Key="TabsBrush" Color="#F5f1ece2"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#c2261f"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#8a5a00"/>
    <SolidColorBrush x:Key="OkBrush" Color="#1f7a3a"/>

    <Color x:Key="CardOnColor">#141214</Color>
    <Color x:Key="CardOnInkColor">#ffffff</Color>
    <Color x:Key="CardOnMetaColor">#c9c3b8</Color>
    <Color x:Key="CardOffInkColor">#141214</Color>
    <Color x:Key="CardOffMetaColor">#4f494b</Color>

    <LinearGradientBrush x:Key="BackdropScrim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2e4dfd3" Offset="0"/>
        <GradientStop Color="#B3e4dfd3" Offset="0.5"/>
        <GradientStop Color="#EBe4dfd3" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">Impact, Arial Black</FontFamily>
    <FontFamily x:Key="MonoFont">Courier New, Consolas</FontFamily>
    <FontFamily x:Key="BodyFont">Courier New, Consolas</FontFamily>

    <CornerRadius x:Key="RadiusInput">0</CornerRadius>
    <CornerRadius x:Key="RadiusTile">0</CornerRadius>
    <CornerRadius x:Key="RadiusModule">0</CornerRadius>
    <CornerRadius x:Key="RadiusDock">0</CornerRadius>
    <CornerRadius x:Key="RadiusPlay">0</CornerRadius>
    <CornerRadius x:Key="RadiusChromeBox">0</CornerRadius>
</ResourceDictionary>
