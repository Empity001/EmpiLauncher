<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PUNK's own control shapes, merged after Themes/Controls.xaml: poster type over typewriter text, tags stamped crooked, buttons as
         stickers with a hard black shadow that the press squashes, and the main action ripped out of black paper, in the accent's ink. -->

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper2Brush}"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper3Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Module" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ModuleBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="22,20"/>
    </Style>
    <!-- a tag stamped by hand: never quite straight -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="#f1ece2"/>
        <Setter Property="BorderBrush" Value="#141214"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-1.5"/></Setter.Value></Setter>
    </Style>

    <!-- a sticker: a hard black shadow under the face; pressing pushes the face down onto it -->
    <ControlTemplate x:Key="StickerButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent">
            <Border Background="#141214" Margin="3,3,0,0"/>
            <Grid x:Name="Face" Margin="0,0,3,3">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <Border x:Name="Over" Background="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Over" Property="Opacity" Value="0.18"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform X="2" Y="2"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource StickerButtonTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Background" Value="#f1ece2"/>
        <Setter Property="Foreground" Value="#141214"/>
        <Setter Property="BorderBrush" Value="#141214"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PaperButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="#fffdf8"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="#c2261f"/>
    </Style>

    <!-- the main action: ripped out of black paper, its word in the accent's ink (PlayInkBrush keeps it readable on black). The tear is a mask
         on rectangles, which take the button's size instead of imposing one. -->
    <DrawingBrush x:Key="TornMask" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Brush="Black" Geometry="M0,8 L8,0 30,6 55,0 80,5 100,0 97,50 100,100 70,94 45,100 20,93 0,100 3,50Z"/></DrawingBrush.Drawing>
    </DrawingBrush>
    <ControlTemplate x:Key="TornButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{StaticResource TornMask}"/>
            <Rectangle x:Name="Over" Fill="#ffffff" Opacity="0" IsHitTestVisible="False" OpacityMask="{StaticResource TornMask}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Over" Property="Opacity" Value="0.1"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Over" Property="Opacity" Value="0.16"/>
                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.96"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource TornButtonTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Background" Value="#141214"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayInkBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
