<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SHELL: a terminal. Warm black and phosphor paper, every text in a monospaced face, display type in the dot-matrix Doto, corners
         nearly square, and the chosen card inverted like a terminal selection. The Play label ends in a cursor (StyleTheme.Label). -->

    <Color x:Key="WellColor">#0a0908</Color>
    <Color x:Key="BgColor">#0d0c0b</Color>
    <Color x:Key="SurfaceColor">#141210</Color>
    <Color x:Key="Surface2Color">#1b1916</Color>
    <Color x:Key="Surface3Color">#23201c</Color>
    <Color x:Key="LineColor">#2a2723</Color>
    <Color x:Key="LineStrongColor">#3d3934</Color>
    <Color x:Key="PaperColor">#d9d4c7</Color>
    <Color x:Key="Paper2Color">#a39e92</Color>
    <Color x:Key="Paper3Color">#77736a</Color>
    <Color x:Key="PaperInkColor">#3a3631</Color>

    <SolidColorBrush x:Key="WellBrush" Color="#0a0908"/>
    <SolidColorBrush x:Key="BgBrush" Color="#0d0c0b"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141210"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#1b1916"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#23201c"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2a2723"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#3d3934"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#d9d4c7"/>
    <SolidColorBrush x:Key="Paper2Brush" Color="#a39e92"/>
    <SolidColorBrush x:Key="Paper3Brush" Color="#77736a"/>
    <SolidColorBrush x:Key="PaperInkBrush" Color="#3a3631"/>
    <SolidColorBrush x:Key="ModuleBrush" Color="#D90E0D0C"/>
    <SolidColorBrush x:Key="HairBrush" Color="#2Ed9d4c7"/>
    <SolidColorBrush x:Key="HairStrongBrush" Color="#57d9d4c7"/>
    <SolidColorBrush x:Key="TintBrush" Color="#0Dd9d4c7"/>
    <SolidColorBrush x:Key="TintHoverBrush" Color="#1Fd9d4c7"/>
    <SolidColorBrush x:Key="DockBrush" Color="#F20E0D0C"/>
    <SolidColorBrush x:Key="DockEdgeBrush" Color="#47d9d4c7"/>
    <SolidColorBrush x:Key="ChromeInkBrush" Color="#d9d4c7"/>
    <SolidColorBrush x:Key="ChromeBoxBrush" Color="#F20E0D0C"/>
    <SolidColorBrush x:Key="TitleBrush" Color="#d9d4c7"/>

    <Color x:Key="CardOnColor">#d9d4c7</Color>
    <Color x:Key="CardOnInkColor">#0d0c0b</Color>
    <Color x:Key="CardOnMetaColor">#3a3631</Color>
    <Color x:Key="CardOffInkColor">#d9d4c7</Color>
    <Color x:Key="CardOffMetaColor">#77736a</Color>

    <LinearGradientBrush x:Key="BackdropScrim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F50d0c0b" Offset="0"/>
        <GradientStop Color="#A60d0c0b" Offset="0.5"/>
        <GradientStop Color="#EB0d0c0b" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Doto Black, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="BodyFont">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="RadiusInput">3</CornerRadius>
    <CornerRadius x:Key="RadiusTile">3</CornerRadius>
    <CornerRadius x:Key="RadiusModule">4</CornerRadius>
    <CornerRadius x:Key="RadiusDock">6</CornerRadius>
    <CornerRadius x:Key="RadiusPlay">4</CornerRadius>
</ResourceDictionary>
