<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- REMEMBER's own control shapes, merged after Themes/Controls.xaml: paper with a pencil outline and uneven corners, tags circled
         in the accent's crayon, handwritten display type, and buttons drawn like the rest (never perfect pills). -->

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper2Brush}"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper3Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Module" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ModuleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairStrongBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusModule}"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="12,4,12,4"/>
        <Setter Property="Padding" Value="9,2"/>
    </Style>

    <!-- a button drawn in pencil: uneven corners all around, a soft press -->
    <ControlTemplate x:Key="PencilButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14,5,13,6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <Border x:Name="Over" Background="#2b2620" Opacity="0" CornerRadius="14,5,13,6" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Over" Property="Opacity" Value="0.08"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Over" Property="Opacity" Value="0.14"/>
                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PencilButtonTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairStrongBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PaperButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="#fffaf0"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="#b8402c"/>
    </Style>

    <!-- the main action: the accent's crayon, outlined in pencil, handwritten -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
        <Setter Property="BorderBrush" Value="#2b2620"/>
        <Setter Property="BorderThickness" Value="2.5"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    </Style>
</ResourceDictionary>
