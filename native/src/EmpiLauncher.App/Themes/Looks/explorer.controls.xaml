<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- EXPLORER's own control shapes, merged after Themes/Controls.xaml. Every button has the same shape on every side (the Play button
         too): rounded push buttons with a dark blue outline and a light gradient, a glossy green Play, and blue and red caption buttons. -->

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper2Brush}"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper3Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- panels: a beige body with the thin blue-grey outline of the era's frames -->
    <Style x:Key="Module" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ModuleBrush}"/>
        <Setter Property="BorderBrush" Value="#7f9db9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="#f5f4ea"/>
        <Setter Property="BorderBrush" Value="#7f9db9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <LinearGradientBrush x:Key="XpFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#f4f3ee" Offset="0.3"/>
        <GradientStop Color="#ecebe6" Offset="0.7"/>
        <GradientStop Color="#d6d0c5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpFacePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#d6d0c5" Offset="0"/>
        <GradientStop Color="#e3e2da" Offset="0.4"/>
        <GradientStop Color="#f4f3ee" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpGreen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8ad88a" Offset="0"/>
        <GradientStop Color="#4fb34f" Offset="0.42"/>
        <GradientStop Color="#379b37" Offset="0.5"/>
        <GradientStop Color="#2f8a2f" Offset="0.85"/>
        <GradientStop Color="#3e9f3e" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpBlueCaption" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7aa6fb" Offset="0"/>
        <GradientStop Color="#3b77f0" Offset="0.45"/>
        <GradientStop Color="#2661dc" Offset="0.55"/>
        <GradientStop Color="#1c52cd" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpRedCaption" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#eaa08a" Offset="0"/>
        <GradientStop Color="#dc6b4e" Offset="0.45"/>
        <GradientStop Color="#cf4a2c" Offset="0.55"/>
        <GradientStop Color="#bd3a1e" Offset="1"/>
    </LinearGradientBrush>

    <!-- the push button: the same rounded corners all around; the pointer lights an amber edge inside it, a press sinks the face -->
    <ControlTemplate x:Key="XpButtonTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding Tag}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <Border x:Name="Hot" Margin="1" BorderBrush="#f8b330" BorderThickness="2" CornerRadius="{TemplateBinding Tag}" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hot" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource XpFacePressed}"/>
                <Setter TargetName="Hot" Property="Opacity" Value="0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource XpButtonTemplate}"/>
        <Setter Property="Tag"><Setter.Value><CornerRadius>3</CornerRadius></Setter.Value></Setter>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Background" Value="{StaticResource XpFace}"/>
        <Setter Property="Foreground" Value="#111111"/>
        <Setter Property="BorderBrush" Value="#003c74"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PaperButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="#c0321c"/>
    </Style>

    <!-- Play and every main action: glossy green, white bold italic, the same round corners on both sides -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Tag"><Setter.Value><CornerRadius>6</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="{StaticResource XpGreen}"/>
        <Setter Property="Foreground" Value="#ffffff"/>
        <Setter Property="BorderBrush" Value="#1d5e1d"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>

    <!-- the window's caption buttons: small rounded squares with a white rim, blue, and red for closing -->
    <ControlTemplate x:Key="XpCaptionTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Face" Width="23" Height="23" Background="{TemplateBinding Background}" BorderBrush="#ffffff" BorderThickness="1" CornerRadius="3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#ffffff"/>
            </Border>
            <Border x:Name="Over" Width="23" Height="23" Background="#ffffff" CornerRadius="3" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Over" Property="Opacity" Value="0.22"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Over" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource XpCaptionTemplate}"/>
        <Setter Property="Background" Value="{StaticResource XpBlueCaption}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Width" Value="27"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Background" Value="{StaticResource XpRedCaption}"/>
    </Style>
    <Style x:Key="EyeButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="FontSize" Value="11"/>
    </Style>
</ResourceDictionary>
