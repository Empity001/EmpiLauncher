<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TÉRMICO's own control shapes, merged after Themes/Controls.xaml: heavy display type (HomeView writes the modpack's name in
         capitals), panels edged with the heat gradient, small square-ish tags, and Jugar painted in the heat gradient. -->

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Paper2Brush}"/>
    </Style>
    <Style x:Key="Module" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ModuleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HeatEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="#14ffffff"/>
        <Setter Property="BorderBrush" Value="#40ffffff"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <LinearGradientBrush x:Key="HeatFillBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#ff8a3d" Offset="0"/>
        <GradientStop Color="#ff4f9a" Offset="0.55"/>
        <GradientStop Color="#b06bff" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{StaticResource HeatFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayInkBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Black"/>
    </Style>
</ResourceDictionary>
