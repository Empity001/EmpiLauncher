<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:EmpiLauncher.App.Themes">

    <!-- text -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <!-- dots stay one colour: ClearType would fringe every dot red and cyan -->
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Paper2Brush}"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Paper3Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- keyboard focus: a 2px accent ring, like the classic launcher's focus style -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Margin="-3" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- buttons -->
    <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
        <!-- things answer the hand: a button lifts a pixel under the pointer (140 ms), sinks when pressed (100 ms in, 160 ms back) and
             fades to a dim when it cannot be used. The visual states animate from wherever the button is, so it never jumps. -->
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{x:Static themes:Motion.Hover}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                        <VisualTransition To="Pressed" GeneratedDuration="{x:Static themes:Motion.PressIn}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                        <VisualTransition From="Pressed" GeneratedDuration="{x:Static themes:Motion.PressOut}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"/>
                    <!-- The animations target the ELEMENT's transform through a property path, on purpose: a transform reached by its own
                         name is applied at the end of a transition instead of being animated through it. Lift and press are two
                         elements (outer and inner), each with one transform, for the same reason. -->
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Over" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="{x:Static themes:Motion.LiftY}" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Over" Storyboard.TargetProperty="Opacity" To="0.02" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="{x:Static themes:Motion.PressScale}" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="{x:Static themes:Motion.PressScale}" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <Border x:Name="Over" Background="White" Opacity="0" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Background" Value="{StaticResource TintHoverBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PaperButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Paper2Brush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- containers -->
    <Style x:Key="Module" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ModuleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusModule}"/>
        <Setter Property="Padding" Value="20,18"/>
        <!-- the module answers the pointer: its outline firms up (the living field also contours it in dots) -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource HairStrongBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TintBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <!-- a button that is only its content (screenshot tiles): hover brightens, keyboard focus shows the ring -->
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static themes:Motion.Hover}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                                    <VisualTransition To="Pressed" GeneratedDuration="{x:Static themes:Motion.PressIn}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                                    <VisualTransition From="Pressed" GeneratedDuration="{x:Static themes:Motion.PressOut}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Over" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0"/></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Over" Storyboard.TargetProperty="Opacity" To="0.03" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="{x:Static themes:Motion.TilePressScale}" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="{x:Static themes:Motion.TilePressScale}" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                        <ContentPresenter/>
                        <Border x:Name="Over" Background="White" Opacity="0" CornerRadius="14" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a modpack card in the rail: the Background/Foreground are set by the view (paper when selected) -->
    <Style x:Key="PackCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- a card leans in a few pixels toward the pointer, like the Publisher's, and settles back when it leaves -->
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static themes:Motion.PressOut}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Over" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="{x:Static themes:Motion.CardShiftX}" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusTile}" Padding="14,12">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <Border x:Name="Over" Background="White" Opacity="0" CornerRadius="{StaticResource RadiusTile}" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- switch -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- the accent fill and the thumb's ink are second layers that fade in, because a colour that follows the modpack's
                         accent (a dynamic resource) cannot be animated directly; the thumb travels its 16 px on the ease-in-out curve -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static themes:Motion.Toggle}" GeneratedEasingFunction="{StaticResource EaseInOut}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbHolder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Track" Background="#1AFFFFFF" CornerRadius="12"/>
                        <Border x:Name="TrackOn" Background="{DynamicResource AccentBrush}" CornerRadius="12" Opacity="0"/>
                        <Grid x:Name="ThumbHolder" Width="18" Height="18" Margin="3" HorizontalAlignment="Left">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Ellipse x:Name="Thumb" Fill="{StaticResource PaperBrush}"/>
                            <Ellipse x:Name="ThumbOn" Fill="{DynamicResource AccentInkBrush}" Opacity="0"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- text box -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="#9E060607"/>
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PaperBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- focus lights an accent outline that fades in over the quiet one -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static themes:Motion.Hover}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{StaticResource HairBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInput}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FocusFrame" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusInput}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tabs (radio buttons that look like the Publisher's pill tabs) -->
    <Style x:Key="TabPill" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Paper2Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- the chosen pill's paper fill fades in (and the label turns dark) as the previous one fades out -->
                    <Grid MinHeight="34">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static themes:Motion.Hover}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static themes:Motion.Tab}" GeneratedEasingFunction="{StaticResource EaseOut}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" To="{StaticResource BgColor}" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="HoverFill" Background="#14FFFFFF" Opacity="0" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"/>
                        <Border x:Name="OnFill" Background="{StaticResource PaperBrush}" Opacity="0" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"/>
                        <ContentPresenter x:Name="Label" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextElement.Foreground><SolidColorBrush Color="{StaticResource Paper2Color}"/></TextElement.Foreground>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- range slider (RAM) -->
    <Style x:Key="RangeSlider" TargetType="Slider">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="#1AFFFFFF"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource PaperBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="3"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- progress (a pill track with an accent fill) -->
    <Style x:Key="PillProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="3" Background="#1AFFFFFF"/>
                        <Border x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource AccentBrush}"/></Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- scroll bar: thin, square-ended, paper on hover -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="8">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="#4DF1EFE8" CornerRadius="4" Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{StaticResource PaperBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
