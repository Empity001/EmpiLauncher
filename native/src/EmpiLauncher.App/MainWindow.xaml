<Window x:Class="EmpiLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empi Launcher (native prototype)" Width="1100" Height="650" MinWidth="900" MinHeight="560"
        Background="#0b0b0d" Foreground="#f1efe8" FontFamily="Segoe UI Variable Text">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="22" Background="#111114" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Versiones" FontSize="16" Margin="6,0,0,12"/>
                <ItemsControl x:Name="Rail">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Background="{Binding Fill}" Padding="12" Margin="0,0,0,6" Cursor="Hand" Tag="{Binding Id}" MouseLeftButtonUp="OnPackClick">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding Ink}"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{Binding InkSoft}" Margin="0,2,0,0" FontFamily="Cascadia Mono"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
            <TextBlock x:Name="PackTitle" Text="Conectando con el motor..." FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="PackSub" Text="" Margin="0,6,0,22" TextAlignment="Center" Foreground="#a5a598" TextWrapping="Wrap"/>
            <Border x:Name="PlayButton" CornerRadius="28" Background="#ff3d8b" Padding="16" Cursor="Hand" MouseLeftButtonUp="OnPlayClick">
                <TextBlock x:Name="PlayLabel" Text="JUGAR" HorizontalAlignment="Center" Foreground="#050506" FontWeight="Bold" FontSize="18"/>
            </Border>
            <TextBlock x:Name="Status" Margin="0,16,0,0" TextAlignment="Center" Foreground="#a5a598" FontFamily="Cascadia Mono" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
