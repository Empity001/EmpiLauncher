<Window x:Class="EmpiLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empi Launcher" Width="1120" Height="700" MinWidth="940" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WellBrush}" Foreground="{StaticResource PaperBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Margin="24,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="EMPI" Style="{StaticResource DisplayText}" FontSize="19" FontWeight="ExtraBold"/>
                <Border Style="{StaticResource Pill}" Margin="14,0,0,0" Padding="9,2"><TextBlock x:Name="ChannelLabel" Text="NATIVO" Style="{StaticResource LabelText}" FontSize="10.5"/></Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource IconButton}" Content="&#xE921;" Width="40" Height="34" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/>
                <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Content="&#xE922;" Width="40" Height="34" ToolTip="Maximizar" AutomationProperties.Name="Maximizar"/>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" Width="40" Height="34" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"/>
            </StackPanel>
        </Grid>

        <ContentPresenter x:Name="ViewHost" Grid.Row="1"/>

        <!-- the screenshot viewer lives here while it is open -->
        <Grid x:Name="ViewerLayer" Grid.RowSpan="2"/>

        <!-- toast: short messages that do not need an answer -->
        <Border x:Name="Toast" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,110" MaxWidth="620"
                Style="{StaticResource Module}" Background="#F218181C" Padding="18,12">
            <DockPanel>
                <Button x:Name="ToastClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Width="30" Height="30" FontSize="11" Margin="12,0,0,0" AutomationProperties.Name="Cerrar aviso"/>
                <TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- dialog: a question or a failure that needs an answer -->
        <Grid x:Name="DialogLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="#B3060607">
            <Border Style="{StaticResource Module}" Background="#FF111114" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource DisplayText}" FontSize="24" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock x:Name="DialogMessage" Style="{StaticResource BodyText}" Foreground="{StaticResource Paper2Brush}" Margin="0,12,0,0"/>
                    <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
