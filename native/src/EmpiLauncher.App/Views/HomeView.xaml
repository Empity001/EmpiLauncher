<UserControl x:Class="EmpiLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- rail: the modpacks ("versiones") -->
        <Border Style="{StaticResource Module}" Padding="14,16,10,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,0,10,12">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock x:Name="RailCount" Style="{StaticResource LabelText}" FontSize="11"/></Border>
                    <TextBlock Text="VERSIONES" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="Rail" Margin="0,0,6,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- the selected modpack -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="12,0,12,24">
                <WrapPanel x:Name="Pills" Margin="0,0,0,16"/>
                <TextBlock x:Name="PackTitle" Style="{StaticResource DisplayText}" FontSize="46" TextWrapping="Wrap" TextTrimming="None" LineHeight="50"/>
                <TextBlock x:Name="PackDescription" Style="{StaticResource BodyText}" Foreground="{StaticResource Paper2Brush}" Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left"/>

                <Border Style="{StaticResource Module}" Margin="0,28,0,0" MaxWidth="560" HorizontalAlignment="Left" Padding="20,16">
                    <UniformGrid x:Name="Facts" Columns="3"/>
                </Border>

                <Border x:Name="ProgressPanel" Style="{StaticResource Module}" Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left" Padding="20,16" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Style="{StaticResource DisplayText}" FontSize="20" Margin="12,0,0,0"/>
                            <TextBlock x:Name="ProgressText" Style="{StaticResource BodyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </DockPanel>
                        <ProgressBar x:Name="ProgressBar" Style="{StaticResource PillProgress}" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ProgressDetail" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- the dock: account, settings and the main action -->
            <Border Grid.Row="1" CornerRadius="{StaticResource RadiusDock}" Background="#F20E0F11" BorderBrush="{StaticResource HairBrush}" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="40" Height="40" Margin="4,0,12,0">
                            <Ellipse Fill="{StaticResource Surface3Brush}"/>
                            <TextBlock x:Name="AvatarInitial" Style="{StaticResource DisplayText}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="AvatarImage" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AccountName" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            <TextBlock x:Name="AccountKind" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE713;" Margin="0,0,10,0" ToolTip="Ajustes" AutomationProperties.Name="Ajustes"/>

                    <Grid Grid.Column="2" Width="340" Height="52" VerticalAlignment="Center">
                        <Grid.Clip><RectangleGeometry x:Name="PlayClip" Rect="0,0,340,52" RadiusX="26" RadiusY="26"/></Grid.Clip>
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Padding="0" Height="52" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Border x:Name="PlayFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="PlayLabel" Style="{StaticResource DisplayText}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentInkBrush}"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
