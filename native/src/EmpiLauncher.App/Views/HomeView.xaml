<UserControl x:Class="EmpiLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- rail: the modpacks ("versiones") -->
        <Border x:Name="RailModule" Style="{StaticResource Module}" Padding="14,16,10,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,0,10,12">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock x:Name="RailCount" Style="{StaticResource LabelText}" FontSize="11"/></Border>
                    <TextBlock Text="VERSIONES" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="Rail" Margin="0,0,6,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- the selected modpack -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="Hero" VerticalAlignment="Center" Margin="12,0,12,24">
                <WrapPanel x:Name="Pills" Margin="0,0,0,16"/>
                <!-- the modpack's own logo when it has one (a small still preview from the engine); the dotted name otherwise -->
                <Image x:Name="PackBanner" Visibility="Collapsed" Stretch="Uniform" HorizontalAlignment="Left" MaxHeight="190" MaxWidth="440"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="PackTitle" Style="{StaticResource DisplayText}" FontSize="46" TextWrapping="Wrap" TextTrimming="None" LineHeight="50"/>
                <TextBlock x:Name="PackDescription" Style="{StaticResource BodyText}" Foreground="{StaticResource Paper2Brush}" Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left"/>

                <!-- what the author says about a modpack that is closed, not out yet or retired -->
                <Border x:Name="AccessNote" Style="{StaticResource Module}" Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left" Padding="20,14" Visibility="Collapsed">
                    <TextBlock x:Name="AccessNoteText" Style="{StaticResource BodyText}" Foreground="{StaticResource Paper2Brush}"/>
                </Border>

                <Border x:Name="FactsModule" Style="{StaticResource Module}" Margin="0,28,0,0" MaxWidth="560" HorizontalAlignment="Left" Padding="20,16">
                    <UniformGrid x:Name="Facts" Columns="4"/>
                </Border>

                <Border x:Name="ProgressPanel" Style="{StaticResource Module}" Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left" Padding="20,16" Visibility="Collapsed">
                    <Grid>
                    <!-- work is going on: a halftone cloud sits behind the text and crosses the panel as the progress advances (set by the code, only while busy) -->
                    <Image x:Name="ProgressCloud" Width="230" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-16" Opacity="0.16" IsHitTestVisible="False" Stretch="Uniform"
                           Visibility="Collapsed"><Image.RenderTransform><TranslateTransform x:Name="ProgressCloudShift"/></Image.RenderTransform></Image>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Style="{StaticResource DisplayText}" FontSize="20" Margin="12,0,0,0"/>
                            <TextBlock x:Name="ProgressText" Style="{StaticResource BodyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </DockPanel>
                        <ProgressBar x:Name="ProgressBar" Style="{StaticResource PillProgress}" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ProgressDetail" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- the dock: account, settings and the main action -->
            <Border x:Name="Dock" Grid.Row="1" CornerRadius="{StaticResource RadiusDock}" Background="#F20E0F11" BorderBrush="{StaticResource HairBrush}" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="40" Height="40" Margin="4,0,12,0">
                            <Ellipse Fill="{StaticResource Surface3Brush}"/>
                            <TextBlock x:Name="AvatarInitial" Style="{StaticResource DisplayText}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="AvatarImage" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AccountName" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            <TextBlock x:Name="AccountKind" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Ajustes" AutomationProperties.Name="Ajustes"/>
                        <!-- only while the modpack is retired: the gear steps aside and this one takes its place next to Play -->
                        <Button x:Name="TrashButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="6,0,0,0" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"
                                ToolTip="Quitar este modpack de mi PC" AutomationProperties.Name="Quitar este modpack de mi PC"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Grid Width="340" Height="52">
                          <Grid x:Name="PlayHost" Width="340" Height="52">
                            <Grid.Clip><RectangleGeometry x:Name="PlayClip" Rect="0,0,340,52" RadiusX="26" RadiusY="26"/></Grid.Clip>
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Padding="0" Height="52" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <!-- the progress fill is as wide as the button and grows by scaling from its left edge (a transform, not a layout change) -->
                                    <Border x:Name="PlayFill" HorizontalAlignment="Left" Width="340" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="PlayFillScale" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                    <TextBlock x:Name="PlayLabel" Style="{StaticResource DisplayText}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentInkBrush}"/>
                                </Grid>
                            </Button>
                          </Grid>
                          <!-- not clipped: the seal is crooked and reaches past the button; the glass of a retired modpack takes the button's place -->
                          <Grid x:Name="AccessLayer" Width="340" Height="52" IsHitTestVisible="False"/>
                        </Grid>
                        <!-- the way in for someone with no account (or no internet): only offered while nobody is signed in -->
                        <Button x:Name="OfflineButton" Style="{StaticResource BareButton}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="14,5"
                                AutomationProperties.Name="Iniciar sin conexión">
                            <TextBlock Text="Iniciar sin conexión" Style="{StaticResource LabelText}" FontSize="12" Foreground="{StaticResource Paper2Brush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
