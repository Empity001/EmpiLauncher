<UserControl x:Class="EmpiLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel x:Name="Header" Margin="0,0,0,18">
            <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource PaperButton}" Content="Listo" Padding="26,11"/>
            <TextBlock x:Name="TitleText" Text="AJUSTES" Style="{StaticResource DisplayText}" FontSize="30" VerticalAlignment="Center" Margin="0,0,24,0" DockPanel.Dock="Left"/>
            <Border Background="#B3111215" BorderBrush="{StaticResource HairBrush}" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Padding="4" HorizontalAlignment="Left">
                <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
            </Border>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ContentPresenter x:Name="TabHost" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,14,0"/>
        </ScrollViewer>
    </Grid>
</UserControl>
